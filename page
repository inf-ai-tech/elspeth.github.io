  var STATS = [
    { num: '3', what: 'reusable AI assurance toolkits, built at Codified Legal', story: 'codified' },
    { num: '25', what: 'fee earners in structured pilots of three AI platforms at Anderson Strathern', story: 'as' },
    { num: '50+', what: 'international clients used her practical regulatory guidance', story: 'codified' }
  ];

  var STEPS = [
    { title: 'Understand the system and the rules', short: 'Understand', text: 'Start with what the AI system does and which rules apply. Her research at the University of Oslo focused on risk management for high-risk AI under the EU AI Act.', ev: ['E17', 'E12'] },
    { title: 'Test how it behaves', short: 'Test', text: 'Test the system on real work before relying on it, from evaluation and benchmarking at InfAI to structured supplier pilots at Anderson Strathern.', ev: ['E07', 'E10'] },
    { title: 'Build practical controls', short: 'Control', text: 'Turn requirements into frameworks, checklists and product features that people can follow, such as the assurance toolkits built at Codified Legal.', ev: ['E02', 'E05'] },
    { title: 'Embed it', short: 'Embed', text: 'Make it last through policy, training and clear guidance, including AI literacy training for 250 fee earners at Anderson Strathern.', ev: ['E13', 'E03'] }
  ];

  var ORGS = [
    { name: 'Codified Legal', story: 'codified' },
    { name: 'InfAI', story: 'infai' },
    { name: 'Anderson Strathern LLP', story: 'as' },
    { name: 'University of Oslo', story: 'oslo' }
  ];

  function evById(id) { for (var i = 0; i < EVIDENCE.length; i++) if (EVIDENCE[i].id === id) return EVIDENCE[i]; return null; }
  function storyIndex(key) { for (var i = 0; i < STORIES.length; i++) if (STORIES[i].key === key) return i; return 0; }
  function stripStop(s) { return s.replace(/\.$/, ''); }
  function lc(s) { return /^[A-Z][a-z]/.test(s) ? s.charAt(0).toLowerCase() + s.slice(1) : s; }

  // ---------- Organisation strip ----------
  function orgRow(hidden) {
    return '<ul class="org-row"' + (hidden ? ' aria-hidden="true"' : '') + '>' + ORGS.map(function (o) {
      return '<li><button class="org js-story" type="button" data-story="' + o.story + '"' + (hidden ? ' tabindex="-1"' : '') + ' aria-label="More on ' + o.name + '">' + o.name + '</button></li>';
    }).join('') + '</ul>';
  }
  $('org-track').innerHTML = orgRow(false) + orgRow(true) + orgRow(true) + orgRow(true);
  var stripToggle = $('strip-toggle');
  stripToggle.addEventListener('click', function () {
    var paused = $('strip').classList.toggle('is-paused');
    stripToggle.textContent = paused ? 'Play' : 'Pause';
    stripToggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
  });

  // ---------- Four parts ----------
  var currentPart = 'build';
  $('parts-tabs').innerHTML = PART_ORDER.map(function (k) {
    var n = EVIDENCE.filter(function (e) { return e.parts.indexOf(k) !== -1; }).length;
    return '<button class="part" type="button" role="tab" id="tab-' + k + '" data-part="' + k + '" aria-selected="false" aria-controls="ev-panel" tabindex="-1">' +
      '<span class="part-name">' + PARTS[k].name + '</span>' +
      '<span class="part-line">' + PARTS[k].line + '</span>' +
      '<span class="part-foot"><span>' + n + ' examples</span><span class="part-on">' + CHECK + 'Showing</span></span>' +
      '</button>';
  }).join('');

  function evItem(e) {
    var r = ROLES[e.role];
    var from = r.title === r.short ? r.short : r.title + ', ' + r.short;
    var link = r.story
      ? '<button class="tlink js-story" type="button" data-story="' + r.story + '">More on ' + r.short + '</button>'
      : '<a class="tlink" href="#record">See career history</a>';
    return '<li class="ev" id="ev-' + e.id + '"><div><p class="ev-text">' + e.text + '</p>' +
      '<div class="ev-meta">' + (e.measure ? '<span class="badge">' + e.measure + '</span>' : '') +
      '<span class="ev-from">' + from + '</span>' + link + '</div></div></li>';
  }

  function selectPart(k, opts) {
    opts = opts || {};
    if (!PARTS[k]) return;
    currentPart = k;
    var items = EVIDENCE.filter(function (e) { return e.parts.indexOf(k) !== -1; });
    $('ev-panel').setAttribute('aria-labelledby', 'tab-' + k);
    $('ev-panel').innerHTML = '<p class="ev-count"><strong>' + PARTS[k].name + '</strong> · ' + items.length + ' examples</p><ul>' + items.map(evItem).join('') + '</ul>';
    Array.prototype.forEach.call(document.querySelectorAll('.part'), function (b) {
      var on = b.getAttribute('data-part') === k;
      b.setAttribute('aria-selected', on ? 'true' : 'false');
      b.tabIndex = on ? 0 : -1;
    });
    if (opts.flash) {
      var el = $('ev-' + opts.flash);
      if (el) { go(el, 'center'); el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash'); }
    } else if (opts.scroll) {
      go($('parts'));
    }
  }

  function goEvidence(id) {
    var e = evById(id);
    if (!e) return;
    var k = e.parts.indexOf(currentPart) !== -1 ? currentPart : e.parts[0];
    selectPart(k, { flash: id });
  }

  // ---------- Stories ----------
  var currentStory = 0;
  $('story-tabs').innerHTML = STORIES.map(function (s, i) {
    return '<button class="tab" type="button" role="tab" id="stab-' + s.key + '" data-index="' + i + '" aria-selected="false" aria-controls="story-card" tabindex="-1">' + s.tab + '</button>';
  }).join('');

  function chartSVG(c) {
    var W = 380, top = 4, rowH = 52, axisH = 24;
    var plotW = W - 4;
    var H = top + c.rows.length * rowH + axisH;
    var x = function (v) { return plotW * v / c.max; };
    var g = '';
    c.ticks.forEach(function (t, i) {
      var xx = Math.min(Math.max(x(t), 0.5), plotW - 0.5);
      g += '<line class="c-grid" x1="' + xx + '" x2="' + xx + '" y1="' + top + '" y2="' + (top + c.rows.length * rowH) + '"/>';
      var anchor = i === 0 ? 'start' : (i === c.ticks.length - 1 ? 'end' : 'middle');
      g += '<text class="c-axis" x="' + xx + '" y="' + (H - 6) + '" text-anchor="' + anchor + '">' + t + c.unit + '</text>';
    });
    c.rows.forEach(function (r, i) {
      var y0 = top + i * rowH;
      var w = Math.max(x(r.value), 3);
      var inside = r.value / c.max > 0.6;
      g += '<text class="c-lab' + (r.ours ? ' is-ours' : '') + '" x="0" y="' + (y0 + 15) + '">' + r.label + '</text>';
      g += '<rect class="' + (r.ours ? 'c-bar-ours' : 'c-bar') + '" x="0" y="' + (y0 + 23) + '" width="' + w + '" height="20" rx="4"/>';
      g += '<text class="c-val' + (inside ? (r.ours ? ' in-ours' : ' in') : '') + '" x="' + (inside ? w - 8 : w + 8) + '" y="' + (y0 + 37) + '" text-anchor="' + (inside ? 'end' : 'start') + '">' + r.display + '</text>';
    });
    var aria = c.title + '. ' + c.rows.map(function (r) { return r.label + ': ' + r.display; }).join('; ');
    return '<svg class="chart" viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + aria + '">' + g + '</svg>';
  }

  function renderStory(i) {
    currentStory = (i + STORIES.length) % STORIES.length;
    var s = STORIES[currentStory];
    var left = s.chart
      ? '<p class="chart-title">' + s.chart.title + '</p>' + (s.chart.note ? '<p class="chart-note">' + s.chart.note + '</p>' : '')
      : '<p class="chart-title">At a glance</p>';
    left += '<div class="badges">' + s.badges.map(function (b) { return '<span class="badge">' + b + '</span>'; }).join('') + '</div>';
    if (s.chart) left += chartSVG(s.chart);
    $('story-card').setAttribute('aria-labelledby', 'stab-' + s.key);
    $('story-card').innerHTML =
      '<div class="story-grid">' +
        '<div class="story-left">' + left + '</div>' +
        '<div class="story-right">' +
          '<p class="story-tag">' + s.tag + '</p>' +
          '<h3 class="story-h">' + s.headline + '</h3>' +
          '<p>' + s.did + '</p>' +
          '<p>' + s.result + '</p>' +
          '<button class="tlink js-part" type="button" data-part="' + s.part + '">More on ' + lc(PARTS[s.part].name) + '</button>' +
        '</div>' +
      '</div>';
    Array.prototype.forEach.call(document.querySelectorAll('.tab'), function (t) {
      var on = Number(t.getAttribute('data-index')) === currentStory;
      t.setAttribute('aria-selected', on ? 'true' : 'false');
      t.tabIndex = on ? 0 : -1;
      if (on && t.scrollIntoView && t.parentNode.scrollWidth > t.parentNode.clientWidth) {
        t.parentNode.scrollLeft = t.offsetLeft - 16;
      }
    });
  }
  function openStory(key, scroll) {
    renderStory(storyIndex(key));
    if (scroll) go($('stories'));
  }
  $('story-prev').addEventListener('click', function () { renderStory(currentStory - 1); });
  $('story-next').addEventListener('click', function () { renderStory(currentStory + 1); });

  // ---------- Numbers ----------
  $('stats').innerHTML = STATS.map(function (s) {
    return '<div class="card stat"><span class="stat-num">' + s.num + '</span><p class="stat-what">' + s.what + '</p>' +
      '<button class="tlink js-story" type="button" data-story="' + s.story + '">More detail</button></div>';
  }).join('');

  // ---------- How I work ----------
  var step = 0, playing = !reduce, hold = false;
  $('track-nodes').innerHTML = STEPS.map(function (s, i) {
    return '<li class="node"><button class="node-dot js-step" type="button" data-step="' + i + '" aria-label="Step ' + (i + 1) + ': ' + stripStop(s.title) + '">' + (i + 1) + '</button><span class="node-name">' + s.short + '</span></li>';
  }).join('');
  $('how-list').innerHTML = STEPS.map(function (s, i) {
    return '<li><button class="how-item js-step" type="button" data-step="' + i + '"><span class="how-num">' + (i + 1) + '</span><span><span class="how-h">' + s.title + '</span><span class="how-p">' + s.text + '</span></span></button></li>';
  }).join('');

  function setStep(i) {
    step = (i + STEPS.length) % STEPS.length;
    var s = STEPS[step];
    $('track-fill').style.setProperty('--p', String(step / (STEPS.length - 1)));
    Array.prototype.forEach.call(document.querySelectorAll('.node'), function (n, j) {
      n.classList.toggle('is-done', j < step);
      n.classList.toggle('is-active', j === step);
    });
    Array.prototype.forEach.call(document.querySelectorAll('.how-item'), function (b, j) {
      if (j === step) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
    });
    $('how-now').innerHTML = '<p class="how-step">Step ' + (step + 1) + ' of ' + STEPS.length + '</p>' +
      '<p class="how-title">' + s.title + '</p>' +
      '<div class="how-ev"><span>Examples:</span>' + s.ev.map(function (id) {
        var e = evById(id);
        return '<button class="tlink js-ev" type="button" data-ev="' + id + '">' + ROLES[e.role].short + '</button>';
      }).join('') + '</div>';
  }
  function setPlaying(p) {
    playing = p;
    $('how-play').textContent = p ? 'Pause' : 'Play';
    $('how-play').setAttribute('aria-pressed', p ? 'false' : 'true');
  }
  $('how-prev').addEventListener('click', function () { setStep(step - 1); });
  $('how-next').addEventListener('click', function () { setStep(step + 1); });
  $('how-play').addEventListener('click', function () { setPlaying(!playing); });
  ['how-diagram', 'how-list'].forEach(function (id) {
    var el = $(id);
    el.addEventListener('mouseenter', function () { hold = true; });
    el.addEventListener('mouseleave', function () { hold = false; });
    el.addEventListener('focusin', function () { hold = true; });
    el.addEventListener('focusout', function () { hold = false; });
  });
  $('how-diagram').addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight') { e.preventDefault(); setStep(step + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); setStep(step - 1); }
  });
  setInterval(function () { if (playing && !hold && !document.hidden) setStep(step + 1); }, 5500);

  // ---------- Career ----------
  $('career').innerHTML = CAREER.map(function (k) {
    var r = ROLES[k];
    var link = r.story
      ? '<button class="tlink c-go js-story" type="button" data-story="' + r.story + '">More detail</button>'
      : '<span class="c-now">' + (r.current ? 'Current' : '') + '</span>';
    return '<li><span class="c-when">' + r.dates + '</span><span class="c-role">' + r.title + '</span><span class="c-org">' + r.org + '</span>' + link + '</li>';
  }).join('');

  // ---------- Copy email ----------
  var toast = $('toast'), toastTimer;
  function showToast(html, ms) {
    toast.innerHTML = html;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.hidden = true; }, ms || 2600);
  }
  function copyEmail(btn) {
    var label = btn.getAttribute('data-label');
    var ok = function () {
      btn.textContent = 'Copied';
      setTimeout(function () { btn.textContent = label; }, 2000);
      showToast('Email address copied.');
    };
    var fail = function () {
      showToast('Copying isn’t available here. The address is <span class="email">' + EMAIL + '</span>', 9000);
    };
    try { navigator.clipboard.writeText(EMAIL).then(ok, fail); } catch (e) { fail(); }
  }

  // Menu button stays a text link while another main button is on screen
  var navBtn = $('nav-cta');
  if ('IntersectionObserver' in window) {
    var seen = [];
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        var i = seen.indexOf(en.target);
        if (en.isIntersecting && i === -1) seen.push(en.target);
        if (!en.isIntersecting && i !== -1) seen.splice(i, 1);
      });
      navBtn.classList.toggle('is-link', seen.length > 0);
    });
    io.observe($('hero-cta'));
    io.observe($('end-cta'));
  }

  // ---------- Keyboard for tab lists ----------
  function tabKeys(listId, selector) {
    $(listId).addEventListener('keydown', function (e) {
      var tabs = Array.prototype.slice.call(this.querySelectorAll(selector));
      var i = tabs.indexOf(document.activeElement);
      if (i === -1) return;
      var n = null;
      if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
      if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
      if (e.key === 'Home') n = 0;
      if (e.key === 'End') n = tabs.length - 1;
      if (n === null) return;
      e.preventDefault();
      tabs[n].focus();
      tabs[n].click();
    });
  }
  tabKeys('parts-tabs', '.part');
  tabKeys('story-tabs', '.tab');

  // ---------- One click handler for the whole page ----------
  document.addEventListener('click', function (e) {
    var t = e.target.closest('button');
    if (!t) return;
    if (t.classList.contains('js-copy')) { copyEmail(t); return; }
    if (t.classList.contains('js-story')) { openStory(t.getAttribute('data-story'), true); return; }
    if (t.classList.contains('js-part')) { selectPart(t.getAttribute('data-part'), { scroll: true }); return; }
    if (t.classList.contains('js-ev')) { goEvidence(t.getAttribute('data-ev')); return; }
    if (t.classList.contains('js-step')) { setStep(Number(t.getAttribute('data-step'))); return; }
    if (t.classList.contains('part')) { selectPart(t.getAttribute('data-part')); return; }
    if (t.classList.contains('tab')) { renderStory(Number(t.getAttribute('data-index'))); return; }
  });

  selectPart('build');
  renderStory(0);
  setStep(0);
  setPlaying(playing);
})();
</script>
</body>
</html>
